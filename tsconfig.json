{
  // Type-checks tests and config (packages build via their own tsconfig).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@abigaail/schema": ["./packages/schema/src/index.ts"],
      "@abigaail/schema/validate": ["./packages/schema/src/validate.ts"],
      "@abigaail/core": ["./packages/core/src/index.ts"],
      "@abigaail/store": ["./packages/store/src/index.ts"],
      "@abigaail/server": ["./apps/server/src/index.ts"]
    }
  },
  "include": ["packages/*/test", "apps/*/test", "vitest.config.ts"]
}
