# Copy to apps/dashboard/.env (never commit it). Read by `npm run dashboard`; paths are relative to the repo root.
# The monitoring database, opened read-only.
ABIGAAIL_DB_PATH=./data/abigaail.db
# Users and sessions (written by the dashboard and the user:* CLI).
ABIGAAIL_AUTH_DB_PATH=./data/auth.db
# Seals TOTP secrets. Must be the same value the user:* CLI ran with.
# Generate with: openssl rand -base64 32
ABIGAAIL_DASHBOARD_SECRET=
# ABIGAAIL_DASHBOARD_HOST=127.0.0.1
# ABIGAAIL_DASHBOARD_PORT=4319
# Behind one reverse proxy on this machine, take the client address from X-Forwarded-For.
# ABIGAAIL_DASHBOARD_TRUST_PROXY=1
