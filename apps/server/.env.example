# Copy to apps/server/.env (never committed). `npm run dev:server` and
# `npm run alerts:test` read it. Every setting is optional; a setting that is
# set but invalid stops the server with a message naming the variable.

# --- Alerts: only confirmed red findings notify (README, "Alerts") ---------

# Webhook: https, or http only to localhost. The secret signs every message
# (X-Abigaail-Signature); generate one with: openssl rand -base64 32
# ABIGAAIL_ALERT_WEBHOOK_URL=https://ntfy.sh/your-long-random-topic
# ABIGAAIL_ALERT_WEBHOOK_SECRET=
# json (default), slack, discord or ntfy
# ABIGAAIL_ALERT_WEBHOOK_FORMAT=ntfy
# Only for a receiver on your own network (LAN, Tailscale): allows private,
# CGNAT and ULA addresses for the webhook. Link-local/metadata stay refused.
# ABIGAAIL_ALERT_WEBHOOK_ALLOW_PRIVATE=1

# Email over SMTP: port 465 (TLS) or 587 (STARTTLS, required). Certificates are verified.
# ABIGAAIL_SMTP_HOST=smtp.example.com
# ABIGAAIL_SMTP_PORT=587
# ABIGAAIL_SMTP_USER=
# ABIGAAIL_SMTP_PASSWORD=
# ABIGAAIL_ALERT_EMAIL_FROM=abigaail@example.com
# Up to 5, comma-separated
# ABIGAAIL_ALERT_EMAIL_TO=you@example.com

# Links in alerts point here (shown only, never fetched).
# ABIGAAIL_DASHBOARD_URL=http://localhost:4319

# Dead-man's switch: pinged every 5 min while Abigaail is healthy
# (healthchecks.io, Uptime Kuma push monitor). Same rules as the webhook URL.
# ABIGAAIL_HEARTBEAT_URL=https://hc-ping.com/your-uuid
# Only for a monitor on your own network (e.g. Uptime Kuma over Tailscale);
# link-local/metadata stay refused.
# ABIGAAIL_HEARTBEAT_ALLOW_PRIVATE=1
