# Copy to .env and fill in the key from: npm run app:create -- demo
ABIGAAIL_ENDPOINT=http://127.0.0.1:4318/ingest
ABIGAAIL_INGEST_KEY=
ABIGAAIL_RELEASE=demo-node-dev
ABIGAAIL_ENVIRONMENT=development
# Optional: where it runs, for the dashboard map (e.g. LON1)
# ABIGAAIL_REGION=LON1
# Optional: a directory for the crash record, so a restart says why the last process ended
# ABIGAAIL_CRASH_RECORD_DIR=/tmp/abigaail-demo
# Optional: profiling (where the time and memory go; Runtime tab)
# ABIGAAIL_PROFILING=1
# Optional: deploy metadata, as a deploy step would set it (README: Deploy metadata; Releases tab)
# ABIGAAIL_COMMIT=0123456789abcdef0123456789abcdef01234567
# ABIGAAIL_PREVIOUS_RELEASE=demo-node-previous
# The lockfile's SHA-256: sha256sum package-lock.json | cut -d' ' -f1
# ABIGAAIL_LOCKFILE_HASH=
